{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    // src/prisma/seed.ts runs directly under `node src/prisma/seed.ts`, and
    // Node's ESM resolver requires the explicit .ts extension on its import.
    "allowImportingTsExtensions": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // No "baseUrl": it is deprecated and stops working in TypeScript 7.
    // Without it, "paths" resolves relative to this file's directory, which is
    // the project root either way. Next 16 handles this (pathsBasePath).
    "paths": {
      "@/*": ["./*"]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "app/lib/placeholder-data.ts",
    "scripts/seed.js",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}