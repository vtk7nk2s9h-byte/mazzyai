# --- Auth (Better Auth) ---
# Signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
# Where the app is served; Better Auth builds callback and email links from it.
BETTER_AUTH_URL=http://localhost:3000

# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mazzyai"

# --- Retell (voice agent) ---
# This file is tracked by git. Placeholders only — real values go in .env,
# which .gitignore covers.
#
# Secret. Server-side only: the `pnpm retell:create-agent` script. Never
# prefix this with NEXT_PUBLIC_ — that would bundle it into the browser.
RETELL_API_KEY=
# Voice for the agent, picked from the voice library in the Retell dashboard.
RETELL_VOICE_ID=
# Optional. Retell POSTs call_started / call_ended / call_analyzed here.
# RETELL_WEBHOOK_URL=

# Safe in the browser: a domain-locked public key that can only open web
# calls. Add localhost to its allowed domains to test locally.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=
# Printed by `pnpm retell:create-agent`.
NEXT_PUBLIC_RETELL_AGENT_ID=

# reCAPTCHA v3 site key, only needed if the Retell public key above has
# reCAPTCHA enabled. The matching *secret* key is not used by this app —
# paste it into the Retell dashboard, which verifies the token server-side.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Email (Resend) ---
# Used by app/lib/email.ts — the email-code sign-in in lib/auth.ts is its
# first caller. Get a key at https://resend.com/api-keys.
RESEND_API_KEY=
# Optional. Without a verified sending domain, leave unset — email.ts falls
# back to Resend's shared onboarding@resend.dev sender for testing.
# EMAIL_FROM="Your App <no-reply@yourdomain.com>"
