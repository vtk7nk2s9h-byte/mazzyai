// =============================================================================
// AGENTS & KNOWLEDGE
// =============================================================================

model Agent {
  id               String        @id @default(uuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  status           AgentStatus   @default(IDLE)
  retellAgentId    String?       @unique
  currentVersionId String?       @unique
  currentVersion   AgentVersion? @relation("AgentCurrentVersion", fields: [currentVersionId], references: [id])
  createdByUserId  String?
  createdBy        User?         @relation("AgentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()
  archivedAt       TimestamptzString?

  versions           AgentVersion[]      @relation("AgentVersions")
  phoneNumbers       PhoneNumber[]
  calls              Call[]
  knowledgeDocuments KnowledgeDocument[]
  meetings           Meeting[]

  @@index([organizationId, status])
}

// Every publish creates a new immutable version — full history, easy rollback.
model AgentVersion {
  id                   String @id @default(uuid())
  agentId              String
  agent                Agent  @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  version              Int
  promptTemplate       String
  variablesSchema      Json // { key: { required: bool, description: string } }
  voiceId              String
  llmModel             String @default("gpt-4o-mini") // provider-side model choice
  language             String @default("en")
  temperature          Float  @default(0.4)
  maxCallDurationMs    Int    @default(600000)
  endCallSilenceMs     Int    @default(20000)
  retellAgentVersionId String?
  changelog            String?
  publishedByUserId    String?
  publishedBy          User?  @relation("VersionPublishedBy", fields: [publishedByUserId], references: [id])
  publishedAt          TimestamptzString?
  createdAt            TimestamptzString @default(now())

  usedAsCurrentFor Agent? @relation("AgentCurrentVersion")
  calls            Call[]

  @@unique([agentId, version])
}

model KnowledgeDocument {
  id                    String              @id @default(uuid())
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId               String?
  agent                 Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  title                 String
  sourceType            KnowledgeSourceType
  sourceUrl             String?
  filePath              String?
  textContent           String?
  sizeBytes             Int?
  retellKnowledgeBaseId String?
  status                KnowledgeDocStatus  @default(PENDING)
  indexedAt             TimestamptzString?
  errorMessage          String?
  createdByUserId       String?
  createdBy             User?               @relation("DocumentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt             TimestamptzString   @default(now())
  updatedAt             temporal.updatedAtString()

  @@index([organizationId])
  @@index([agentId])
}

// =============================================================================
// TELEPHONY & CALLS (production, org-scoped)
// =============================================================================

model PhoneNumber {
  id                  String                @id @default(uuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // locationId          String?
  // location            OrganizationLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  agentId             String?
  agent               Agent?                @relation(fields: [agentId], references: [id], onDelete: SetNull)
  e164                String                @unique
  label               String?
  country             String
  areaCode            String?
  retellPhoneNumberId String?               @unique
  monthlyCostCents    Int                   @default(0)
  isActive            Boolean               @default(true)
  purchasedAt         TimestamptzString     @default(now())
  releasedAt          TimestamptzString?

  calls Call[]

  @@index([organizationId])
}

model Call {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent         @relation(fields: [agentId], references: [id])
  agentVersionId String?
  agentVersion   AgentVersion? @relation(fields: [agentVersionId], references: [id])
  phoneNumberId  String?
  phoneNumber    PhoneNumber?  @relation(fields: [phoneNumberId], references: [id])

  retellCallId String        @unique
  direction    CallDirection
  status       CallStatus    @default(REGISTERED)

  fromNumber String?
  toNumber   String?
  callerName String?

  startedAt        TimestamptzString?
  endedAt          TimestamptzString?
  durationMs       Int?
  disconnectReason String?

  transferredTo String?
  transferredAt TimestamptzString?

  recordingUrl    String?
  consentToRecord Boolean @default(true)

  transcript String?
  summary    String?
  sentiment  CallSentiment @default(UNKNOWN)

  dynamicVariables   Json? // what we sent in
  collectedVariables Json? // what Retell collected during the call
  costCents          Int?  @default(0)
  // No default: @default([]) lowers to an invalid '[]'::json[] literal, and a
  // list cannot take dbgenerated(). Creates must pass rawEvents: [] explicitly.
  rawEvents          Json[] // every webhook payload received

  // derived from org.dataRetentionDays, for cleanup jobs
  retentionExpiresAt TimestamptzString?

  createdAt TimestamptzString @default(now())

  transcriptLines CallTranscriptLine[]
  tags            CallTag[]

  @@index([organizationId, createdAt])
  @@index([agentId])
  @@index([status])
}

// Optional granular turn-by-turn transcript, useful for analytics/QA later.
// Kept separate from Call.transcript (the flat text version) on purpose.
model CallTranscriptLine {
  id       String         @id @default(uuid())
  callId   String
  call     Call           @relation(fields: [callId], references: [id], onDelete: Cascade)
  role     TranscriptRole
  content  String
  offsetMs Int // ms from call start

  @@index([callId, offsetMs])
}

// Free-form labels for analytics: "booking", "complaint", "missed-info", etc.
model CallTag {
  id     String @id @default(uuid())
  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  label  String

  @@unique([callId, label])
}

// =============================================================================
// PUBLIC DEMO FUNNEL (landing page, not tenant data)
// =============================================================================

model DemoLead {
  id          String  @id @default(uuid())
  orgName     String
  contactName String?
  email       String
  phone       String
  location    String
  timezone    String
  opensAt     String
  closesAt    String
  industry    String?
  extraNotes  String?

  ipHash      String
  userAgent   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?

  status                  DemoLeadStatus @default(NEW)
  convertedOrganizationId String?
  convertedOrganization   Organization?  @relation("DemoLeadConvertedOrg", fields: [convertedOrganizationId], references: [id])
  convertedAt             TimestamptzString?

  createdAt TimestamptzString @default(now())

  calls  DemoCall[]
  events DemoEvent[]

  @@index([email])
  @@index([ipHash, createdAt])
}

model DemoCall {
  id           String     @id @default(uuid())
  demoLeadId   String
  demoLead     DemoLead   @relation(fields: [demoLeadId], references: [id], onDelete: Cascade)
  retellCallId String?    @unique
  status       CallStatus @default(REGISTERED)
  startedAt    TimestamptzString?
  endedAt      TimestamptzString?
  durationMs   Int?
  transcript   String?
  summary      String?
  costCents    Int?       @default(0)
  rawEvents    Json[] // no default — see Call.rawEvents
  createdAt    TimestamptzString @default(now())

  @@index([demoLeadId])
}

// Funnel analytics: form_viewed -> form_started -> submitted -> token_issued
// -> connected -> ended -> email_sent -> signup_clicked -> signed_up
model DemoEvent {
  id         String    @id @default(uuid())
  demoLeadId String?
  demoLead   DemoLead? @relation(fields: [demoLeadId], references: [id], onDelete: SetNull)
  sessionId  String // client-generated, groups anonymous events pre-lead
  eventType  String
  metadata   Json?
  createdAt  TimestamptzString @default(now())

  @@index([sessionId])
  @@index([eventType, createdAt])
}

// =============================================================================
// USAGE, BILLING
// =============================================================================

// Daily rollup, org-scoped (organizationId null = global/demo usage).
model UsageCounter {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodDate     DateString
  callsCount     Int           @default(0)
  minutesUsed    Float         @default(0)
  costCents      Int           @default(0)

  @@unique([organizationId, periodDate])
}

model Subscription {
  id                        String             @id @default(uuid())
  organizationId            String             @unique
  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeSubscriptionId      String             @unique
  stripePriceId             String
  plan                      Plan
  status                    SubscriptionStatus
  minutesIncluded           Int
  overageRateCentsPerMinute Int
  currentPeriodStart        TimestamptzString
  currentPeriodEnd          TimestamptzString
  cancelAtPeriodEnd         Boolean            @default(false)
  canceledAt                TimestamptzString?
  createdAt                 TimestamptzString  @default(now())
  updatedAt                 temporal.updatedAtString()
}

// A card as the billing UI shows it: brand, last four and expiry only. Never a
// full number or CVC — a processor token would be the real source of these.
model PaymentMethod {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          String
  last4          String
  expMonth       Int
  expYear        Int
  holderName     String
  billingAddress String?
  isDefault      Boolean           @default(false)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([organizationId])
}

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeInvoiceId String        @unique
  amountCents     Int
  status          InvoiceStatus
  periodStart     TimestamptzString
  periodEnd       TimestamptzString
  pdfUrl          String?
  paidAt          TimestamptzString?
  createdAt       TimestamptzString @default(now())

  @@index([organizationId])
}

// An appointment on the organization's agenda — what the voice agent books
// (a table, a viewing, a consultation). Times are UTC like every other
// timestamp; the calendar renders them in the viewer's zone.
model Meeting {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  attendeeName   String?
  location       String?
  // The agent that booked it; NULL for an event added by hand.
  agentId        String?
  agent          Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  startsAt       TimestamptzString
  endsAt         TimestamptzString
  allDay         Boolean           @default(false)
  status         MeetingStatus     @default(SCHEDULED)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([organizationId, startsAt])
  @@index([agentId])
}

// A person an organization chose to keep from a call. One per phone number per
// organization (e164, as Retell reports it), so a repeat caller finds the same
// contact. sourceCallId is the call it was saved from, a plain id rather than a
// relation: deleting a call's history must not delete the contact.
model Contact {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String?
  phone          String
  email          String?
  notes          String?
  sourceCallId   String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([organizationId, phone])
  @@index([organizationId, createdAt])
}

// =============================================================================
// ADMIN / OPS (superuser dashboard)
// =============================================================================

model FeatureFlag {
  id             String           @id @default(uuid())
  key            String // e.g. "demo.enabled", "agent.transfer.beta"
  description    String?
  enabled        Boolean          @default(false)
  payload        Json?
  scope          FeatureFlagScope @default(GLOBAL)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedAt      temporal.updatedAtString()

  @@unique([key, organizationId])
}

// Global operational switches that don't fit the flag model well
// (e.g. numeric budgets rather than booleans).
model SystemSetting {
  key       String @id // "demo.dailyBudgetCents", "demo.maxConcurrentCalls"
  value     Json
  updatedAt temporal.updatedAtString()
}

model AuditLog {
  id             String         @id @default(uuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorType      AuditActorType
  actorUserId    String?
  actorUser      User?          @relation("AuditActorUser", fields: [actorUserId], references: [id])
  action         String // "agent.published", "member.invited", "org.suspended"
  targetType     String
  targetId       String
  diff           Json?
  ipAddress      String?
  createdAt      TimestamptzString @default(now())

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
}

// Generic inbound-webhook log, separate from Call.rawEvents, for
// signature/debug/replay purposes across every provider (Retell, Stripe...).
model WebhookEvent {
  id             String          @id @default(uuid())
  provider       WebhookProvider
  eventType      String
  signatureValid Boolean
  payload        Json
  processedAt    TimestamptzString?
  error          String?
  createdAt      TimestamptzString @default(now())

  @@index([provider, eventType])
}

// =============================================================================
// NOTIFICATIONS, API ACCESS, INTEGRATIONS
// =============================================================================

model Notification {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  body           String?
  isRead         Boolean          @default(false)
  readAt         TimestamptzString?
  createdAt      TimestamptzString @default(now())

  @@index([userId, isRead])
}

// Public API access (backlog item) — scaffolded now so adding it later
// doesn't require a breaking migration.
model ApiKey {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  hashedKey       String       @unique
  lastUsedAt      TimestamptzString?
  createdByUserId String?
  createdBy       User?        @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id])
  revokedByUserId String?
  revokedBy       User?        @relation("ApiKeyRevokedBy", fields: [revokedByUserId], references: [id])
  revokedAt       TimestamptzString?
  createdAt       TimestamptzString @default(now())

  @@index([organizationId])
}

// Third-party connections (calendar, CRM, POS) — backlog, scaffolded.
model Integration {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider             String // "google_calendar", "square", "hubspot"...
  status               String       @default("disconnected")
  encryptedCredentials String?
  metadata             Json?
  connectedAt          TimestamptzString?
  createdAt            TimestamptzString @default(now())

  @@unique([organizationId, provider])
}

// =============================================================================
// SECTOR TEMPLATES (data-driven scalability across industries)
// =============================================================================

// Sector differences must live in data, never in code branches. This model
// backs the "choose your sector" step in onboarding and the demo, and seeds
// AgentVersion.promptTemplate / variablesSchema defaults.
model SectorTemplate {
  id                     String  @id @default(uuid())
  key                    String  @unique // "restaurant", "clinic", "repair_shop"...
  label                  String
  description            String?
  icon                   String?
  defaultPromptTemplate  String
  defaultVariablesSchema Json
  isActive               Boolean @default(true)
  createdAt              TimestamptzString @default(now())
  updatedAt              temporal.updatedAtString()
}
