// use prisma-8
// =============================================================================
// MazzyAI — data contract v1
// =============================================================================
// Read top to bottom: Auth -> Organizations -> Agents -> Telephony/Calls ->
// Public demo funnel -> Billing -> Admin/ops -> Sector templates.
//
// Conventions used throughout:
// - id: uuid() everywhere, so ids are unguessable. (The original draft said
//   cuid(); Prisma 8's SQL PSL provider rejects cuid() even though its error
//   text lists it, so uuid() is the working equivalent.)
// - money: integer minor units (…Cents), never float.
// - time: TimestamptzString is UTC. The *String temporal types carry
//   PostgreSQL's own text rather than Temporal values, so no global Temporal
//   is needed at query time. Human-facing hours are "HH:mm" strings + an IANA
//   timezone string, formatted in code.
// - every tenant-owned row carries organizationId with an index.
// - soft delete (deletedAt) only where "undo" or audit history matters;
//   Prisma 8 has no built-in soft delete, so those queries must filter
//   explicitly.
// - raw third-party payloads are kept as Json for the first months — cheap
//   insurance while the integration is still young.
// =============================================================================

// =============================================================================
// ENUMS
// =============================================================================
// Prisma 8 enums declare their storage codec and map each member to its
// database value explicitly; the planner derives a CHECK constraint from the
// value set.

enum SystemRole {
  @@type("pg/text@1")
  USER      = "USER" // normal member of one or more orgs
  ADMIN     = "ADMIN" // internal staff, read-mostly via superuser dashboard
  SUPERUSER = "SUPERUSER" // full internal admin
}

enum UserStatus {
  @@type("pg/text@1")
  ACTIVE   = "ACTIVE"
  DISABLED = "DISABLED"
}

enum OrgRole {
  @@type("pg/text@1")
  OWNER  = "OWNER"
  ADMIN  = "ADMIN"
  MEMBER = "MEMBER"
  VIEWER = "VIEWER"
}

enum MembershipStatus {
  @@type("pg/text@1")
  INVITED = "INVITED"
  ACTIVE  = "ACTIVE"
  REMOVED = "REMOVED"
}

enum OrgStatus {
  @@type("pg/text@1")
  TRIAL     = "TRIAL"
  ACTIVE    = "ACTIVE"
  PAST_DUE  = "PAST_DUE"
  SUSPENDED = "SUSPENDED"
}

enum Plan {
  @@type("pg/text@1")
  FREE       = "FREE"
  STARTER    = "STARTER"
  PRO        = "PRO"
  ENTERPRISE = "ENTERPRISE"
}

enum Weekday {
  @@type("pg/text@1")
  MONDAY    = "MONDAY"
  TUESDAY   = "TUESDAY"
  WEDNESDAY = "WEDNESDAY"
  THURSDAY  = "THURSDAY"
  FRIDAY    = "FRIDAY"
  SATURDAY  = "SATURDAY"
  SUNDAY    = "SUNDAY"
}

enum AgentStatus {
  @@type("pg/text@1")
  IDLE = "IDLE"
  READY = "READY"
  ACTIVE = "ACTIVE"
  PAUSED = "PAUSED"
  DISACTIVATED = "DISACTIVATED"
}

enum KnowledgeSourceType {
  @@type("pg/text@1")
  FILE = "FILE"
  URL  = "URL"
  TEXT = "TEXT"
}

enum KnowledgeDocStatus {
  @@type("pg/text@1")
  PENDING  = "PENDING"
  INDEXING = "INDEXING"
  INDEXED  = "INDEXED"
  FAILED   = "FAILED"
}

enum CallDirection {
  @@type("pg/text@1")
  INBOUND  = "INBOUND"
  OUTBOUND = "OUTBOUND"
  WEB      = "WEB"
}

enum CallStatus {
  @@type("pg/text@1")
  REGISTERED = "REGISTERED"
  ONGOING    = "ONGOING"
  ENDED      = "ENDED"
  ANALYZED   = "ANALYZED"
  FAILED     = "FAILED"
}

enum CallSentiment {
  @@type("pg/text@1")
  POSITIVE = "POSITIVE"
  NEUTRAL  = "NEUTRAL"
  NEGATIVE = "NEGATIVE"
  UNKNOWN  = "UNKNOWN"
}

enum TranscriptRole {
  @@type("pg/text@1")
  AGENT  = "AGENT"
  USER   = "USER"
  SYSTEM = "SYSTEM"
}

// What kind of email the system sent. Recorded in the AuditLog diff of an
// "email.sent" row for now (see follow-up-email.ts); no table uses it yet.
enum EmailType {
  @@type("pg/text@1")
  MARKETING  = "MARKETING"
  INVITATION = "INVITATION"
  FOLLOW_UP  = "FOLLOW_UP" // after a call
}

enum DemoLeadStatus {
  @@type("pg/text@1")
  NEW       = "NEW"
  CALLED    = "CALLED"
  ANALYZED  = "ANALYZED"
  EMAILED   = "EMAILED"
  CONVERTED = "CONVERTED"
  ABANDONED = "ABANDONED"
}

enum SubscriptionStatus {
  @@type("pg/text@1")
  TRIALING = "TRIALING"
  ACTIVE   = "ACTIVE"
  PAST_DUE = "PAST_DUE"
  CANCELED = "CANCELED"
  UNPAID   = "UNPAID"
}

enum MeetingStatus {
  @@type("pg/text@1")
  SCHEDULED = "SCHEDULED"
  COMPLETED = "COMPLETED"
  CANCELLED = "CANCELLED"
}

enum InvoiceStatus {
  @@type("pg/text@1")
  DRAFT         = "DRAFT"
  OPEN          = "OPEN"
  PAID          = "PAID"
  UNCOLLECTIBLE = "UNCOLLECTIBLE"
  VOID          = "VOID"
}

enum FeatureFlagScope {
  @@type("pg/text@1")
  GLOBAL       = "GLOBAL"
  ORGANIZATION = "ORGANIZATION"
}

enum WebhookProvider {
  @@type("pg/text@1")
  RETELL = "RETELL"
  STRIPE = "STRIPE"
  RESEND = "RESEND"
}

enum NotificationType {
  @@type("pg/text@1")
  MISSED_CALL         = "MISSED_CALL"
  CALL_TRANSFERRED    = "CALL_TRANSFERRED"
  AGENT_PUBLISHED     = "AGENT_PUBLISHED"
  BUDGET_WARNING      = "BUDGET_WARNING"
  BILLING_ISSUE       = "BILLING_ISSUE"
  MEMBER_INVITED      = "MEMBER_INVITED"
  SYSTEM_ANNOUNCEMENT = "SYSTEM_ANNOUNCEMENT"
}

enum AuditActorType {
  @@type("pg/text@1")
  USER      = "USER"
  SUPERUSER = "SUPERUSER"
  SYSTEM    = "SYSTEM"
}

// =============================================================================
// AUTH & USERS
// =============================================================================

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  emailVerified   Boolean           @default(false)
  name            String?
  image           String?
  phone           String?
  // Legacy bcrypt hash from the NextAuth era. Nothing reads or writes it:
  // Better Auth keeps passwords on the "credential" Account row, and
  // scripts/migrate-passwords.ts copies these across. Drop it once every
  // database (local and the Vercel one) has had that script run.
  passwordHash    String?
  timezone        String            @default("UTC")
  locale          String            @default("en")
  // Better Auth's admin plugin reads and writes this as its `role` field
  // (mapped in lib/auth.ts).
  systemRole      SystemRole        @default(USER)
  status          UserStatus        @default(ACTIVE)
  // Admin plugin ban state. Better Auth refuses to create a session while
  // banned is true and banExpires has not passed.
  banned          Boolean           @default(false)
  banReason       String?
  banExpires      TimestamptzString?
  lastLoginAt     TimestamptzString?
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]      @relation("MembershipMember")
  notifications Notification[]

  // things this user created / actioned, across the app
  createdAgents     Agent[]             @relation("AgentCreatedBy")
  publishedVersions AgentVersion[]      @relation("VersionPublishedBy")
  createdDocuments  KnowledgeDocument[] @relation("DocumentCreatedBy")
  sentInvites       Membership[]        @relation("MembershipInvitedBy")
  createdApiKeys    ApiKey[]            @relation("ApiKeyCreatedBy")
  revokedApiKeys    ApiKey[]            @relation("ApiKeyRevokedBy")
  auditLogEntries   AuditLog[]          @relation("AuditActorUser")

  @@index([email])
}

// Better Auth core tables, in the shape its adapter expects. Table and column
// names are Better Auth's defaults, so lib/auth.ts needs no field mapping for
// them.

// One row per way a user can sign in: providerId "credential" holds the
// password hash; "google" etc. hold OAuth tokens.
model Account {
  id                    String             @id @default(uuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?
  createdAt             TimestamptzString  @default(now())
  updatedAt             temporal.updatedAtString()

  @@unique([providerId, accountId])
  @@index([userId])
}

// Database sessions: deleting a row signs that device out immediately.
model Session {
  id             String            @id @default(uuid())
  token          String            @unique
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress      String?
  userAgent      String?
  // Set by the admin plugin while a superuser is signed in as someone else:
  // the superuser's user id, which stopImpersonating() returns to.
  impersonatedBy String?
  expiresAt      TimestamptzString
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([userId])
}

// Short-lived secrets: email OTP codes, magic-link tokens, OAuth state.
model Verification {
  id         String            @id @default(uuid())
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([identifier])
}

// Fixed-window counters for lib/rate-limit.ts: one row per rule and subject
// (e.g. "sign-in:email:alice@x.com"). Written only through raw SQL there, so
// the increment and the window reset happen in one atomic upsert.
model RateLimit {
  key         String            @id
  count       Int
  windowStart TimestamptzString
}

// =============================================================================
// ORGANIZATIONS (tenants)
// =============================================================================

model Organization {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  industry    String? // free text or a key into SectorTemplate
  description String?
  website     String?
  // Contact details live on the organization itself for now. They used to be
  // on OrganizationLocation, which is commented out below.
  email       String?
  phone       String?
  postalCode  String?
  logoUrl     String?
  timezone    String    @default("UTC")
  language    String    @default("en")
  status      OrgStatus @default(TRIAL)
  plan        Plan      @default(FREE)
  trialEndsAt TimestamptzString?

  // billing shortcuts kept on the org for cheap reads; source of truth is
  // Subscription/Invoice
  billingEmail      String?
  stripeCustomerId  String? @unique
  minutesIncluded   Int     @default(0)
  minutesUsedRecord Int     @default(0)

  // operational settings
  recordCalls        Boolean @default(true)
  allowHumanTransfer Boolean @default(false)
  dataRetentionDays  Int     @default(365)
  dailyBudgetCents   Int? // null = uncapped
  notificationEmail  String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  deletedAt TimestamptzString? // soft delete: keep billing/audit history

  memberships         Membership[]
  // locations           OrganizationLocation[]
  agents              Agent[]
  phoneNumbers        PhoneNumber[]
  calls               Call[]
  knowledgeDocuments  KnowledgeDocument[]
  usageCounters       UsageCounter[]
  subscription        Subscription?
  invoices            Invoice[]
  meetings            Meeting[]
  contacts            Contact[]
  paymentMethods      PaymentMethod[]
  apiKeys             ApiKey[]
  integrations        Integration[]
  featureFlagOverride FeatureFlag[]
  auditLogEntries     AuditLog[]
  notifications       Notification[]
  convertedFrom       DemoLead[]             @relation("DemoLeadConvertedOrg")

  @@index([status])
  @@index([plan])
}

model Membership {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation("MembershipMember", fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            OrgRole           @default(MEMBER)
  status          MembershipStatus  @default(ACTIVE)
  invitedByUserId String?
  invitedBy       User?             @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id])
  invitedAt       TimestamptzString?
  joinedAt        TimestamptzString?
  removedAt       TimestamptzString?
  createdAt       TimestamptzString @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

